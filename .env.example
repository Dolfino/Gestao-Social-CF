# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# APP_ENCRYPTION_KEY: Chave de 32 bytes (64 caracteres hexadecimais) para criptografia AES-256-GCM.
# Se ausente, o sistema bloqueia operações criptográficas e solicita a configuração.
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# SESSION_SECRET: Chave para assinatura de sessões internas
SESSION_SECRET="centro_fashion_internal_session_secret_key_change_me"
